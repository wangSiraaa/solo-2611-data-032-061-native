<?xml version="1.0" encoding="UTF-8"?>
<!-- Two different reported values for the same fact whose declared precision
     intervals overlap: 400 (decimals=0 -> [399.5,400.5]) and
     400.2 (decimals=0 -> [399.7,400.7]); they overlap in [399.7,400.5].
     This is 'compatible', not 'identical', and not proof of agreement. -->
