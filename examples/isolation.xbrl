<?xml version="1.0" encoding="UTF-8"?>
<!-- Currency and dimension isolation: a USD parent has no USD children, and a
     South parent has no South children.  Children exist only in CNY/North and
     must NOT be reused for those parents. -->
<xbrli:xbrl xmlns:xbrli="http://www.xbrl.org/2003/instance" xmlns:link="http://www.xbrl.org/2003/linkbase" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xbrldi="http://xbrl.org/2006/xbrldi" xmlns:iso4217="http://www.xbrl.org/2003/iso4217" xmlns:ex="urn:example:facts:v1">
 <link:schemaRef xlink:type="simple" xlink:href="taxonomy/example.xsd"/>
 <xbrli:context id="north-q1">
  <xbrli:entity><xbrli:identifier scheme="urn:example:entity">E-42</xbrli:identifier>
   <xbrli:segment><xbrldi:explicitMember dimension="ex:RegionAxis">ex:North</xbrldi:explicitMember></xbrli:segment>
  </xbrli:entity>
  <xbrli:period><xbrli:startDate>2025-01-01</xbrli:startDate><xbrli:endDate>2025-03-31</xbrli:endDate></xbrli:period>
 </xbrli:context>
 <xbrli:context id="south-q1">
  <xbrli:entity><xbrli:identifier scheme="urn:example:entity">E-42</xbrli:identifier>
   <xbrli:segment><xbrldi:explicitMember dimension="ex:RegionAxis">ex:South</xbrldi:explicitMember></xbrli:segment>
  </xbrli:entity>
  <xbrli:period><xbrli:startDate>2025-01-01</xbrli:startDate><xbrli:endDate>2025-03-31</xbrli:endDate></xbrli:period>
 </xbrli:context>
 <xbrli:unit id="CNY"><xbrli:measure>iso4217:CNY</xbrli:measure></xbrli:unit>
 <xbrli:unit id="USD"><xbrli:measure>iso4217:USD</xbrli:measure></xbrli:unit>
 <!-- balanced CNY North group -->
 <ex:Total contextRef="north-q1" unitRef="CNY" decimals="0">1000</ex:Total>
 <ex:PartA contextRef="north-q1" unitRef="CNY" decimals="0">400</ex:PartA>
 <ex:PartB contextRef="north-q1" unitRef="CNY" decimals="0">600</ex:PartB>
 <!-- USD parent only: must be incomplete, not matched with CNY children -->
 <ex:Total contextRef="north-q1" unitRef="USD" decimals="0">140</ex:Total>
 <!-- South parent only: must be incomplete, not matched with North children -->
 <ex:Total contextRef="south-q1" unitRef="CNY" decimals="0">1000</ex:Total>
</xbrli:xbrl>
