<?xml version="1.0" encoding="UTF-8"?>
<!-- nil, zero and absent are three different things.
     Q1: PartB is nil  -> incomplete (nil is not zero)
     Q2: PartB is 0    -> genuine zero, relation can be checked
     Q3: PartB absent  -> incomplete (no zero invented) -->
<xbrli:xbrl xmlns:xbrli="http://www.xbrl.org/2003/instance" xmlns:link="http://www.xbrl.org/2003/linkbase" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xbrldi="http://xbrl.org/2006/xbrldi" xmlns:iso4217="http://www.xbrl.org/2003/iso4217" xmlns:ex="urn:example:facts:v1">
 <link:schemaRef xlink:type="simple" xlink:href="taxonomy/example.xsd"/>
 <xbrli:context id="q1"><xbrli:entity><xbrli:identifier scheme="urn:example:entity">E-42</xbrli:identifier></xbrli:entity><xbrli:period><xbrli:startDate>2025-01-01</xbrli:startDate><xbrli:endDate>2025-03-31</xbrli:endDate></xbrli:period></xbrli:context>
 <xbrli:context id="q2"><xbrli:entity><xbrli:identifier scheme="urn:example:entity">E-42</xbrli:identifier></xbrli:entity><xbrli:period><xbrli:startDate>2025-04-01</xbrli:startDate><xbrli:endDate>2025-06-30</xbrli:endDate></xbrli:period></xbrli:context>
 <xbrli:context id="q3"><xbrli:entity><xbrli:identifier scheme="urn:example:entity">E-42</xbrli:identifier></xbrli:entity><xbrli:period><xbrli:startDate>2025-07-01</xbrli:startDate><xbrli:endDate>2025-09-30</xbrli:endDate></xbrli:period></xbrli:context>
 <xbrli:unit id="CNY"><xbrli:measure>iso4217:CNY</xbrli:measure></xbrli:unit>
 <ex:Total contextRef="q1" unitRef="CNY" decimals="0">1000</ex:Total>
 <ex:PartA contextRef="q1" unitRef="CNY" decimals="0">400</ex:PartA>
 <ex:PartB contextRef="q1" unitRef="CNY" decimals="0" xsi:nil="true"/>
 <ex:Total contextRef="q2" unitRef="CNY" decimals="0">400</ex:Total>
 <ex:PartA contextRef="q2" unitRef="CNY" decimals="0">400</ex:PartA>
 <ex:PartB contextRef="q2" unitRef="CNY" decimals="0">0</ex:PartB>
 <ex:Total contextRef="q3" unitRef="CNY" decimals="0">400</ex:Total>
 <ex:PartA contextRef="q3" unitRef="CNY" decimals="0">400</ex:PartA>
</xbrli:xbrl>
